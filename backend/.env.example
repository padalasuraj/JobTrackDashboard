# Local defaults work without any environment variables. Java does not load this file automatically.
APP_URL=http://localhost:3000
COOKIE_SECURE=false
PORT=8080
# Production: set SPRING_PROFILES_ACTIVE=prod and supply ALL database credentials.
# Use Neon's pooled host with sslmode=require; no password in JDBC_DATABASE_URL.
JDBC_DATABASE_URL=jdbc:postgresql://your-neon-pooler-host/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=replace-me
# Optional Google web application OAuth credentials. Register this exact redirect URI:
# https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional public password recovery. Requires a verified sender domain on Resend.
RESEND_API_KEY=
EMAIL_FROM=JobTrack <hello@your-verified-domain.com>
# DEV only: print reset links to backend log. Never enable publicly.
DEV_EMAIL_LOG=false
